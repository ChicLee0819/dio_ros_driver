<launch>
  <arg name="config_file" default="$(find-pkg-share dio_ros_driver)/config/dio_ros_driver.params.yaml"/>

  <group>
    <push-ros-namespace namespace="/dio/"/>
    <node pkg="dio_ros_driver" exec="dio_ros_driver_node" name="gpiochip1" output="log" respawn="true">
      <param from="$(var config_file)"/>
    </node>
    <node pkg="dio_ros_driver" exec="dio_ros_driver_node" name="gpiochip2" output="log" respawn="true">
      <param from="$(var config_file)"/>
    </node>
    <node pkg="dio_ros_driver" exec="dout_controler_node" name="controler0" output="log" respawn="true">
      <param from="$(var config_file)"/>
    </node>
    <node pkg="dio_ros_driver" exec="dout_controler_node" name="controler1" output="log" respawn="true">
      <param from="$(var config_file)"/>
    </node>
    <node pkg="dio_ros_driver" exec="dout_controler_node" name="controler2" output="log" respawn="true">
      <param from="$(var config_file)"/>
    </node>
    <node pkg="dio_ros_driver" exec="dout_controler_node" name="controler3" output="log" respawn="true">
      <param from="$(var config_file)"/>
    </node>
    <node pkg="dio_ros_driver" exec="dout_buzzer_node" name="buzzer0" output="log" respawn="true">
      <param from="$(var config_file)"/>
    </node>
  </group>
  <group>
    <node pkg="image_tools" exec="showimage" name="eventimage" output="log" respawn="true"></node>
    <executable cmd="python3 take_picture.py" cwd="/home/oem/dio_ros_driver" launch-prefix="time" output="screen"/>
  </group>
</launch>
